# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*

# Database
MONGODB_URI=mongodb://localhost:27017/fitness

# JWT Authentication
JWT_SECRET=your-very-secure-jwt-secret-at-least-16-characters
JWT_EXPIRES_IN=7d

# Pagination
DEFAULT_PAGE_SIZE=20

# Redis Configuration for BullMQ (Background Jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
