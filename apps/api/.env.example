# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*

# Database
MONGODB_URI=mongodb://localhost:27017/fitness

# JWT Authentication
JWT_SECRET=your-very-secure-jwt-secret-at-least-16-characters
JWT_EXPIRES_IN=7d

# Pagination
DEFAULT_PAGE_SIZE=20

# Redis Configuration for BullMQ (Background Jobs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# API Docs — Swagger UI is served at /api/docs outside production.
# Set to true to expose it in production too.
SWAGGER_ENABLED=false

# Social sign-in. Leave a provider blank and its endpoint returns 501.
# Comma-separated: the Android, iOS and web OAuth client ids.
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Vercel AI SDK — Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
