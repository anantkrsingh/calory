# Same env contract as the API (@fitness/config/server validates all of it),
# but the worker only actually reads the Redis + OTP + SMTP settings below.
NODE_ENV=development

# Database (required by the shared env schema, unused by this process today)
MONGODB_URI=mongodb://localhost:27017/fitness

# Auth (required by the shared env schema, unused by this process today)
JWT_SECRET=your-very-secure-jwt-secret-at-least-16-characters

# Redis configuration for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP configuration
OTP_EXPIRY_MINUTES=10

# SMTP configuration used by nodemailer to send OTP emails.
# Example values for Gmail SMTP relay — use an App Password, not your account password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
# For SendGrid/Mailgun/SES, use their SMTP relay host/port/credentials instead.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
