# Use your machine's LAN IP, not localhost, so a physical device can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1

# Public client identifiers only. EXPO_PUBLIC_* values are compiled into the
# app bundle, so provider secrets belong in the API's .env instead.

# The WEB client id, even on Android: the native SDK needs it as `webClientId`
# to return a verifiable idToken. An Android OAuth client (package + SHA-1)
# must also exist, but its id is not referenced here.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Baked into the native build by the config plugin — changing these needs a
# rebuild, not just a Metro restart.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=

EXPO_PUBLIC_X_CLIENT_ID=
