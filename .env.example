NODE_ENV=production
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*

# External MongoDB (Atlas or self-managed) — not started by docker compose
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/fitness_tracker

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# API docs
SWAGGER_ENABLED=false
DEFAULT_PAGE_SIZE=20

# Redis — host/port are overridden to the compose service in docker-compose.yml
REDIS_PASSWORD=

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=4

# SMTP (OTP emails via worker)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com

# Social sign-in (optional)
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# LLM provider — "openai" (default, needs OPENAI_API_KEY) or "gemini" (needs
# GOOGLE_GENERATIVE_AI_API_KEY below). Routine/quote generation silently
# no-ops without a matching API key for whichever provider is selected here.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
