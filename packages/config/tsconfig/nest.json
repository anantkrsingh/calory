{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Fitness NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "sourceMap": true,
    "incremental": true,
    "removeComments": true
    // `rootDir`/`outDir` are set per app — see the note in library.json.
  }
}
