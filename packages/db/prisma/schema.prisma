// Prisma schema for the fitness tracker — MongoDB.
//
// Embedded documents (sets inside exercises inside workouts) are modelled as
// composite `type` blocks so a whole workout is one read and one write, which is
// what the mobile app's offline-sync path needs.

// Prisma 6 is the terminal major with a MongoDB connector — Prisma 7 ships none.
// Keep these packages pinned to the 6.x line; see README for the migration note.
generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ---------------------------------------------------------------------------
// Enums — values mirror the string unions in @fitness/types exactly.
// ---------------------------------------------------------------------------

enum UserRole {
  user
  admin
}

enum AuthProvider {
  google
  facebook
  x
}

enum UnitSystem {
  metric
  imperial
}

enum Sex {
  male
  female
  other
  prefer_not_to_say
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum FitnessGoal {
  lose_weight
  build_muscle
  improve_fitness
  gain_strength
  stay_healthy
  train_sport
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  forearms
  quads
  hamstrings
  glutes
  calves
  core
  full_body
  cardio
}

enum Equipment {
  barbell
  dumbbell
  kettlebell
  machine
  cable
  bodyweight
  band
  other
}

enum ExerciseCategory {
  strength
  cardio
  duration
  reps
}

enum SetType {
  working
  warmup
  drop
  failure
}

enum WorkoutStatus {
  in_progress
  completed
  cancelled
}

enum GoalType {
  body_weight
  body_fat
  workouts_per_week
  exercise_one_rep_max
  total_volume
  distance_run
}

enum GoalStatus {
  active
  achieved
  abandoned
}

enum WorkoutRoutineStatus {
  generating
  active
  failed
  superseded
}

// ---------------------------------------------------------------------------
// Composite types
// ---------------------------------------------------------------------------

type UserProfile {
  displayName   String
  avatarUrl     String?
  /// ISO calendar date, YYYY-MM-DD.
  dateOfBirth   String?
  sex           Sex?
  heightCm      Float?
  activityLevel ActivityLevel?
  fitnessGoals  FitnessGoal[] @default([])
}

type LinkedAccount {
  provider AuthProvider
  subject  String
  email    String?
  linkedAt DateTime @default(now())
}

type UserPreferences {
  units                UnitSystem @default(metric)
  /// IANA zone; drives "today" boundaries in stats.
  timezone             String     @default("UTC")
  notificationsEnabled Boolean    @default(false)
}

/// One logged set. Which fields matter depends on the exercise's category.
type WorkoutSet {
  /// Client-generated (UUID) so offline-logged sets keep a stable identity.
  id          String
  order       Int
  type        SetType @default(working)
  reps        Int?
  weightKg    Float?
  durationSec Int?
  distanceM   Float?
  /// Rate of perceived exertion, 1-10.
  rpe         Float?
  completed   Boolean @default(false)
  notes       String?
}

type WorkoutExercise {
  id           String
  exerciseId   String       @db.ObjectId
  /// Denormalised so a workout renders offline without the catalogue.
  exerciseName String
  order        Int
  sets         WorkoutSet[]
  restSeconds  Int?
  notes        String?
}

/// Derived totals, recomputed server-side; never trusted from the client.
type WorkoutStats {
  totalSets        Int   @default(0)
  completedSets    Int   @default(0)
  totalVolumeKg    Float @default(0)
  totalReps        Int   @default(0)
  totalDistanceM   Float @default(0)
  totalDurationSec Int   @default(0)
}

type RoutineSet {
  id                String
  order             Int
  type              SetType @default(working)
  targetReps        Int?
  targetWeightKg    Float?
  targetDurationSec Int?
  targetDistanceM   Float?
}

type RoutineExercise {
  id           String
  exerciseId   String       @db.ObjectId
  exerciseName String
  order        Int
  sets         RoutineSet[]
  restSeconds  Int?
  notes        String?
}

/// A configurable prompt for one AI-driven feature (e.g. "workout_suggestion").
type AiPromptConfig {
  key    String
  label  String
  prompt String
}

/// One planned exercise inside an AI-generated routine day.
type RoutinePlanExercise {
  exerciseId   String @db.ObjectId
  exerciseName String
  sets         Int
  reps         Int?
  durationSec  Int?
  restSeconds  Int?
}

/// One day of an AI-generated weekly routine. 1 = Monday .. 7 = Sunday.
type RoutinePlanDay {
  dayOfWeek            Int
  isRestDay            Boolean
  targetCaloriesBurned Int
  focus                String
  exercises            RoutinePlanExercise[]
}

/// Circumferences in centimetres.
type BodyMeasurements {
  neck       Float?
  chest      Float?
  waist      Float?
  hips       Float?
  leftArm    Float?
  rightArm   Float?
  leftThigh  Float?
  rightThigh Float?
  leftCalf   Float?
  rightCalf  Float?
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  passwordHash  String?
  emailVerified Boolean  @default(false)
  role          UserRole @default(user)

  profile     UserProfile
  preferences UserPreferences

  linkedAccounts LinkedAccount[]

  /// Hash of the current refresh token; rotating it revokes the session.
  refreshTokenHash String?
  lastLoginAt      DateTime?

  totalCredits     Int       @default(5)
  remainingCredits Int       @default(5)
  planId           String?   @db.ObjectId
  planName         String?
  planExpiresAt    DateTime?
  plan             Plan?     @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises    Exercise[]
  workouts     Workout[]
  routines     Routine[]
  measurements BodyMeasurement[]
  goals        Goal[]
  workoutRoutines WorkoutRoutine[]

  @@map("users")
}

model Plan {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @unique
  description    String?
  duration       String   // e.g. "monthly", "yearly", "weekly", "lifetime"
  durationDays   Int?     // e.g. 30, 365
  price          Float    @default(0)
  currency       String   @default("USD")
  benefits       String[] // Array of feature bullet points
  storeProductId String?  // RevenueCat / Play Store / App Store ID
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]

  @@map("plans")
}

model Exercise {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  category         ExerciseCategory
  primaryMuscles   MuscleGroup[]
  secondaryMuscles MuscleGroup[]
  equipment        Equipment
  instructions     String?
  /// Main / list thumbnail image (Cloudinary URL).
  thumbnail        String?
  /// Additional gallery images (Cloudinary URLs).
  images           String[] @default([])

  /// Null for the shared catalogue, set for user-authored exercises.
  createdById String? @db.ObjectId
  createdBy   User?   @relation(fields: [createdById], references: [id])
  isCustom    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([createdById, name])
  @@index([category])
  @@index([equipment])
  @@index([primaryMuscles])
  @@map("exercises")
}

model Workout {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  name        String
  status      WorkoutStatus @default(in_progress)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  durationSec Int?

  exercises WorkoutExercise[]
  stats     WorkoutStats
  notes     String?

  routineId String?  @db.ObjectId
  routine   Routine? @relation(fields: [routineId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
  @@map("workouts")
}

model Routine {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  name        String
  description String?
  /// Derived from the routine's exercises; kept for cheap list filtering.
  targetMuscles MuscleGroup[]

  exercises            RoutineExercise[]
  estimatedDurationSec Int?
  isArchived           Boolean           @default(false)
  lastPerformedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workouts Workout[]

  @@index([userId, isArchived])
  @@map("routines")
}

model BodyMeasurement {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  recordedAt        DateTime @default(now())
  weightKg          Float?
  bodyFatPercentage Float?

  measurements BodyMeasurements
  photoUrls    String[]
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, recordedAt])
  @@map("body_measurements")
}

model Goal {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  type         GoalType
  title        String
  targetValue  Float
  startValue   Float
  currentValue Float
  /// Display unit, e.g. kg / % / workouts.
  unit         String

  /// ISO calendar date, YYYY-MM-DD.
  deadline   String?
  status     GoalStatus @default(active)
  achievedAt DateTime?

  /// Required for exercise_one_rep_max goals.
  exerciseId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("goals")
}

/// One AI-generated motivational quote per calendar day.
model DailyQuote {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  /// ISO calendar date, YYYY-MM-DD. Unique so a day can only have one quote.
  date          String @unique
  quoteOfTheDay String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_quotes")
}

/// AI-generated weekly plan. Created as `generating` when a user registers.
model WorkoutRoutine {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status              WorkoutRoutineStatus @default(generating)
  dailyCalorieTarget  Int?
  summary             String?
  days                RoutinePlanDay[]
  /// Set when status is `failed`, for admin debugging.
  error               String?
  generatedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("workout_routines")
}

/// App-wide configuration edited from the admin panel. Always exactly one row.
model AppSettings {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  freeChatsLimit Int             @default(5)
  aiPrompts      AiPromptConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
