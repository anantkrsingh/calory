// Prisma schema for the fitness tracker — MongoDB.
//
// Embedded documents (sets inside exercises inside workouts) are modelled as
// composite `type` blocks so a whole workout is one read and one write, which is
// what the mobile app's offline-sync path needs.

// Prisma 6 is the terminal major with a MongoDB connector — Prisma 7 ships none.
// Keep these packages pinned to the 6.x line; see README for the migration note.
generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ---------------------------------------------------------------------------
// Enums — values mirror the string unions in @fitness/types exactly.
// ---------------------------------------------------------------------------

enum UserRole {
  user
  admin
}

enum AuthProvider {
  google
  facebook
  x
}

enum UnitSystem {
  metric
  imperial
}

enum Sex {
  male
  female
  other
  prefer_not_to_say
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum FitnessGoal {
  lose_weight
  build_muscle
  improve_fitness
  gain_strength
  stay_healthy
  train_sport
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  forearms
  quads
  hamstrings
  glutes
  calves
  core
  full_body
  cardio
}

enum Equipment {
  barbell
  dumbbell
  kettlebell
  machine
  cable
  bodyweight
  band
  other
}

enum ExerciseCategory {
  strength
  cardio
  duration
  reps
}

enum SetType {
  working
  warmup
  drop
  failure
}

enum WorkoutStatus {
  in_progress
  completed
  cancelled
}

enum GoalType {
  body_weight
  body_fat
  workouts_per_week
  exercise_one_rep_max
  total_volume
  distance_run
}

enum GoalStatus {
  active
  achieved
  abandoned
}

/// Which AI feature a configured system prompt belongs to.
enum PromptCategory {
  quote_of_the_day
  workout_routine
  user_chat
}

enum ChatMessageRole {
  user
  assistant
  system
}

enum WorkoutRoutineStatus {
  generating
  active
  failed
  superseded
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

/// Generated once and kept for the routine's lifetime — `active` for a
/// training day, `rest` for a planned recovery/off day.
enum RoutineDayStatus {
  active
  rest
}

// ---------------------------------------------------------------------------
// Composite types
// ---------------------------------------------------------------------------

type UserProfile {
  displayName   String
  avatarUrl     String?
  /// ISO calendar date, YYYY-MM-DD.
  dateOfBirth   String?
  sex           Sex?
  heightCm      Float?
  activityLevel ActivityLevel?
  fitnessGoals  FitnessGoal[] @default([])
}

type LinkedAccount {
  provider AuthProvider
  subject  String
  email    String?
  linkedAt DateTime @default(now())
}

type UserPreferences {
  units                UnitSystem @default(metric)
  /// IANA zone; drives "today" boundaries in stats.
  timezone             String     @default("UTC")
  notificationsEnabled Boolean    @default(false)
}

/// One logged set. Which fields matter depends on the exercise's category.
type WorkoutSet {
  /// Client-generated (UUID) so offline-logged sets keep a stable identity.
  id          String
  order       Int
  type        SetType @default(working)
  reps        Int?
  weightKg    Float?
  durationSec Int?
  distanceM   Float?
  /// Rate of perceived exertion, 1-10.
  rpe         Float?
  completed   Boolean @default(false)
  notes       String?
}

type WorkoutExercise {
  id           String
  exerciseId   String       @db.ObjectId
  /// Denormalised so a workout renders offline without the catalogue.
  exerciseName String
  order        Int
  sets         WorkoutSet[]
  restSeconds  Int?
  notes        String?
}

/// Derived totals, recomputed server-side; never trusted from the client.
type WorkoutStats {
  totalSets        Int   @default(0)
  completedSets    Int   @default(0)
  totalVolumeKg    Float @default(0)
  totalReps        Int   @default(0)
  totalDistanceM   Float @default(0)
  totalDurationSec Int   @default(0)
}

type RoutineSet {
  id                String
  order             Int
  type              SetType @default(working)
  targetReps        Int?
  targetWeightKg    Float?
  targetDurationSec Int?
  targetDistanceM   Float?
}

type RoutineExercise {
  id           String
  exerciseId   String       @db.ObjectId
  exerciseName String
  order        Int
  sets         RoutineSet[]
  restSeconds  Int?
  notes        String?
}

/// A configurable prompt for one AI-driven feature.
type AiPromptConfig {
  promptCategory PromptCategory
  prompt         String
}

/// One planned exercise inside an AI-generated routine day.
type RoutinePlanExercise {
  exerciseId   String @db.ObjectId
  exerciseName String
  sets         Int
  reps         Int?
  durationSec  Int?
  restSeconds  Int?
  /// Optional: absent on routines generated before this field existed.
  estimatedCalories Int?
}

type RoutinePlanDay {
  dayOfWeek            DayOfWeek
  status               RoutineDayStatus @default(active)
  targetCaloriesBurned Int
  /// Optional: absent on routines generated before these fields existed.
  caloriesFromRunning  Int?
  caloriesFromExercises Int?
  stepsTarget          Int?
  runningDistanceKm    Float?
  runningDurationMin   Int?
  focus                String
  exercises            RoutinePlanExercise[]
}

type BodyMeasurements {
  neck       Float?
  chest      Float?
  waist      Float?
  hips       Float?
  leftArm    Float?
  rightArm   Float?
  leftThigh  Float?
  rightThigh Float?
  leftCalf   Float?
  rightCalf  Float?
}


model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  passwordHash  String?
  emailVerified Boolean  @default(false)
  role          UserRole @default(user)

  profile     UserProfile
  preferences UserPreferences

  linkedAccounts LinkedAccount[]

  refreshTokenHash String?
  lastLoginAt      DateTime?

  /// Set when the user requests account deletion; cleared (cancelling the
  /// deletion) if they log back in before the grace period elapses. A worker
  /// cron hard-deletes accounts once this is far enough in the past.
  deletionRequestedAt DateTime?

  totalCredits     Int       @default(5)
  remainingCredits Int       @default(5)
  planId           String?   @db.ObjectId
  planName         String?
  planExpiresAt    DateTime?
  plan             Plan?     @relation(fields: [planId], references: [id])

  /// Lifetime chat token usage, summed across every assistant reply.
  lifetimeInputTokens  Int @default(0)
  lifetimeOutputTokens Int @default(0)
  lifetimeTotalTokens  Int @default(0)

  /// Exercise ids this user has favorited — shown pinned above the muscle-wise
  /// browse on the Build screen.
  favoriteExerciseIds String[] @db.ObjectId @default([])

  /// Expo push tokens, one per device the user has granted notification
  /// permission on. Never exposed on the public User contract.
  pushTokens String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises       Exercise[]
  workouts        Workout[]
  routines        Routine[]
  measurements    BodyMeasurement[]
  goals           Goal[]
  workoutRoutines WorkoutRoutine[]
  chatConversations ChatConversation[]
  dailySteps      DailySteps[]

  @@map("users")
}

model Plan {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @unique
  description    String?
  duration       String   // e.g. "monthly", "yearly", "weekly", "lifetime"
  durationDays   Int?     // e.g. 30, 365
  price          Float    @default(0)
  currency       String   @default("USD")
  benefits       String[] // Array of feature bullet points
  storeProductId String?  // RevenueCat / Play Store / App Store ID
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]

  @@map("plans")
}

/// One step of an exercise's illustrated how-to, distinct from `Exercise.instructions`
/// (a single free-text description). `image` is a Cloudinary URL — either a fresh
/// upload or one reused from the exercise's own `images` gallery.
type ExerciseInstructionStep {
  /// Client-generated (UUID), same convention as WorkoutSet/WorkoutExercise.
  id    String
  order Int
  text  String
  image String?
}

model Exercise {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  category         ExerciseCategory
  primaryMuscles   MuscleGroup[]
  secondaryMuscles MuscleGroup[]
  equipment        Equipment
  /// Short free-text description shown under the name.
  instructions     String?
  /// Ordered, optionally-illustrated step-by-step how-to.
  instructionSteps ExerciseInstructionStep[]
  /// Main / list thumbnail image (Cloudinary URL).
  thumbnail        String?
  /// Additional gallery images (Cloudinary URLs).
  images           String[] @default([])

  /// Null for the shared catalogue, set for user-authored exercises.
  createdById String? @db.ObjectId
  createdBy   User?   @relation(fields: [createdById], references: [id])
  isCustom    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([createdById, name])
  @@index([category])
  @@index([equipment])
  @@index([primaryMuscles])
  @@map("exercises")
}

model Workout {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  name        String
  status      WorkoutStatus @default(in_progress)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  durationSec Int?

  exercises WorkoutExercise[]
  stats     WorkoutStats
  notes     String?

  routineId String?  @db.ObjectId
  routine   Routine? @relation(fields: [routineId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
  @@map("workouts")
}

model Routine {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  name        String
  description String?
  /// Derived from the routine's exercises; kept for cheap list filtering.
  targetMuscles MuscleGroup[]

  exercises            RoutineExercise[]
  estimatedDurationSec Int?
  isArchived           Boolean           @default(false)
  lastPerformedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workouts Workout[]

  @@index([userId, isArchived])
  @@map("routines")
}

model BodyMeasurement {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  recordedAt        DateTime @default(now())
  weightKg          Float?
  bodyFatPercentage Float?

  measurements BodyMeasurements
  photoUrls    String[]
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, recordedAt])
  @@map("body_measurements")
}

/// One day's step count, upserted by (userId, date) as the pedometer reading
/// on-device climbs through the day.
model DailySteps {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ISO calendar date, YYYY-MM-DD, in the device's local timezone.
  date  String
  steps Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("daily_steps")
}

model Goal {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  type         GoalType
  title        String
  targetValue  Float
  startValue   Float
  currentValue Float
  /// Display unit, e.g. kg / % / workouts.
  unit         String

  /// ISO calendar date, YYYY-MM-DD.
  deadline   String?
  status     GoalStatus @default(active)
  achievedAt DateTime?

  /// Required for exercise_one_rep_max goals.
  exerciseId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("goals")
}

/// One AI-generated motivational quote per calendar day.
model DailyQuote {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  /// ISO calendar date, YYYY-MM-DD. Unique so a day can only have one quote.
  date          String @unique
  quoteOfTheDay String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_quotes")
}

/// AI-generated weekly plan. Created as `generating` when a user registers.
model WorkoutRoutine {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status              WorkoutRoutineStatus @default(generating)
  /// Daily calorie intake target.
  dailyCalorieTarget  Int?
  summary             String?
  days                RoutinePlanDay[]
  /// Set when status is `failed`, for admin debugging.
  error               String?
  generatedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("workout_routines")
}

/// App-wide configuration edited from the admin panel. Always exactly one row.
model AppSettings {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  freeChatsLimit Int             @default(5)
  aiPrompts      AiPromptConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// One coaching thread owned by a user. Messages live in `ChatMessage`.
model ChatConversation {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Auto-set from the first user message when omitted.
  title         String?
  messageCount  Int       @default(0)
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String           @db.ObjectId
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    ChatMessageRole
  content String

  /// Token usage for this turn (assistant replies only) — the whole
  /// `streamText` call's `totalUsage`, including any tool round-trips.
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
